# ============================================================
# AI Quant Trade — 生产环境变量模板（M5）
# 复制为 .env 并填入实际值
# 用法：docker compose --env-file .env up -d
# ============================================================

# ----- 公开访问地址（M5: Nginx 统一入口）-----
# 前端浏览器访问的地址（不含端口，Nginx 80 端口）
PUBLIC_API_URL=http://localhost
PUBLIC_WS_URL=ws://localhost/ws/ticker
# 生产域名示例：
# PUBLIC_API_URL=https://trade.example.com
# PUBLIC_WS_URL=wss://trade.example.com/ws/ticker

# ----- 数据库（PostgreSQL）-----
DB_USER=root
DB_PASSWORD=change_me_in_production
DB_NAME=ai_quant_trade

# ----- 交易所 API（必填）-----
# OKX API 申请: https://www.okx.com/account/my-api
# ⚠️ 实盘安全：API Key 只开"交易"权限，禁止开"提币"权限
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_key_here
EXCHANGE_PASSPHRASE=your_passphrase_here
EXCHANGE_NAME=okx
# true=模拟盘(Testnet), false=实盘(Live)
EXCHANGE_TESTNET=true

# ----- DeepSeek AI（选填）-----
# 申请: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=

# ----- 加密密钥（必填）-----
# Fernet AES 密钥，用于加密交易所 Secret
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ----- JWT 密钥（生产必填，>= 32 字符随机串）-----
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 生产环境(DEBUG=false)使用弱密钥将拒绝启动
# ⚠️ 禁止使用含 change/default/your_/todo 的密钥
JWT_SECRET_KEY=
JWT_EXPIRE_MINUTES=1440

# ----- 服务器配置 -----
DEBUG=false
# CORS 白名单（逗号分隔，生产用域名）
CORS_ORIGINS=http://localhost,https://localhost,http://localhost:3000

# ----- 代理（连 OKX 需要，国内环境）-----
HTTPS_PROXY=
HTTP_PROXY=

# ----- 风控硬上限 -----
MAX_ORDER_AMOUNT_USDT=200.0
MAX_TOTAL_POSITION_USDT=2000.0
MAX_DAILY_LOSS_PCT=5.0

# ----- 实盘交易对白名单 -----
LIVE_SYMBOL_WHITELIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# ----- AI 功能开关 -----
DISABLE_AI_IN_LIVE=true

# ----- 新闻情绪（选填）-----
CRYPTOPANIC_AUTH_TOKEN=
