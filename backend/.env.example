# ============================================================
# AI Quant Trade — 环境变量配置模板
# 复制为 .env 并填入实际值
# ============================================================

# ----- 交易所 API（必填）-----
# OKX API 申请: https://www.okx.com/account/my-api
# ⚠️ 实盘安全：API Key 只开"交易"权限，禁止开"提币"权限
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_key_here
EXCHANGE_PASSPHRASE=your_passphrase_here
EXCHANGE_NAME=okx
# true=模拟盘(Testnet), false=实盘(Live)
EXCHANGE_TESTNET=true

# ----- DeepSeek AI（选填，模拟盘用）-----
# 申请: https://platform.deepseek.com/api_keys
# 实盘模式默认禁用 AI（DISABLE_AI_IN_LIVE=true）
DEEPSEEK_API_KEY=

# ----- 加密密钥（首次启动自动生成，也可手动设置）-----
# Fernet AES 密钥，用于加密交易所 Secret
# 生成方法: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=

# ----- JWT 密钥（生产必填，>= 32 字符随机串）-----
# 生成方法: python -c "import secrets; print(secrets.token_urlsafe(32))"
# ⚠️ 生产环境(DEBUG=false)使用默认值将拒绝启动
JWT_SECRET_KEY=ai_quant_jwt_secret_key_change_in_prod_2024
JWT_EXPIRE_MINUTES=1440

# ----- 数据库 -----
# SQLite（默认，开发用）: sqlite+aiosqlite:///./data/trading.db
# PostgreSQL（生产推荐）: postgresql+asyncpg://user:pass@host:5432/dbname
DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# ----- 服务器 -----
HOST=0.0.0.0
PORT=8000
# true=开发模式(热重载+默认JWT), false=生产模式(强制安全检查)
DEBUG=true

# ----- CORS 白名单（逗号分隔）-----
# 允许的前端来源；开发环境默认覆盖 3000/3001/3002 常用端口
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3001,http://127.0.0.1:3001,http://localhost:3002,http://127.0.0.1:3002

# ----- 代理（连 OKX 需要，国内环境）-----
HTTPS_PROXY=http://127.0.0.1:7890
HTTP_PROXY=http://127.0.0.1:7890

# ----- 风控硬上限（保守档，用户确认）-----
# 单笔下单金额上限（USDT）
MAX_ORDER_AMOUNT_USDT=200.0
# 总持仓金额上限（USDT）
MAX_TOTAL_POSITION_USDT=2000.0
# 日亏损百分比上限
MAX_DAILY_LOSS_PCT=5.0

# ----- 实盘交易对白名单（逗号分隔，实盘模式仅允许这些交易对）-----
LIVE_SYMBOL_WHITELIST=BTC/USDT,ETH/USDT,SOL/USDT,BNB/USDT,XRP/USDT

# ----- AI 功能开关 -----
# 实盘模式是否禁用 AI（true=实盘禁用，模拟盘启用）
DISABLE_AI_IN_LIVE=true

# ----- 新闻情绪（选填）-----
# CryptoPanic API Token: https://cryptopanic.com/developers/api/
CRYPTOPANIC_AUTH_TOKEN=

# ----- 前端（Next.js 环境变量）-----
# API 基址
NEXT_PUBLIC_API_URL=http://localhost:8000
# WebSocket URL（生产用 wss）
NEXT_PUBLIC_WS_URL=ws://localhost:8000/ws/ticker
