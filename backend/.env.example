# OKX API 凭证
# 申请地址: https://www.okx.com/account/my-api
EXCHANGE_API_KEY=your_api_key_here
EXCHANGE_SECRET=your_secret_key_here
EXCHANGE_PASSPHRASE=your_passphrase_here
EXCHANGE_TESTNET=true

# DeepSeek AI
# 申请地址: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your_deepseek_key_here

# 加密密钥 — 首次启动时自动生成，写入 .env。也可手动设置 32 字节随机字符串
# ENCRYPTION_KEY=

# JWT — 生产环境务必更换为强随机密钥
# JWT_SECRET_KEY=  （留空则使用默认开发密钥，不安全）

# 数据库 (默认 SQLite)
# DATABASE_URL=sqlite+aiosqlite:///./data/trading.db

# 服务器
HOST=0.0.0.0
PORT=8000
DEBUG=true

# CORS 白名单（逗号分隔，默认仅 localhost）
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
